# PostgreSQL connection string. On Vercel Postgres this is the *pooled* URL; locally the two
# below are the same value, since there is no pooler in front of a local database.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mi_dokta?schema=public"
# Direct (non-pooled) connection, used only by prisma migrate.
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mi_dokta?schema=public"

# Profile photo storage. Leave unset to write to ./uploads on local disk; set it (Vercel Blob)
# on any serverless host, where the filesystem is read-only.
BLOB_READ_WRITE_TOKEN=""

# Secret used to sign login sessions — use a long random string
SESSION_SECRET="replace-with-a-long-random-string"

# ---- SMS notifications ----
# Provider: console (log only, for development) | smsgate | twilio | africastalking
SMS_PROVIDER="console"
SMS_BRAND_NAME="Mi Dokta"
SMS_DEFAULT_COUNTRY_CODE="232"
APP_TIME_ZONE="Africa/Freetown"
SMS_DAILY_SCHEDULE_HOUR="7"
# SMS Gateway for Android (SMS_PROVIDER=smsgate) — an Android phone with a local SIM does the
# sending, so texts go at local rates and patients can reply. No card and no provider account
# needed. Credentials come from the app's "Cloud Server" screen.
# SMSGATE_BASE_URL: leave blank for the public cloud relay. Set it to your own private server, or
# to the phone itself on the same network (http://<phone-ip>:8080).
SMSGATE_USERNAME=""
SMSGATE_PASSWORD=""
SMSGATE_BASE_URL=""
# Twilio (SMS_PROVIDER=twilio).
# TWILIO_FROM: on a TRIAL account this must be your Twilio phone number (+1...). Alphanumeric
# sender IDs such as "MiDokta" are rejected on trials with error 21267 — they need a paid account.
# On a paid account it can be a phone number, an alphanumeric sender ID, or a Messaging Service SID.
# Trial accounts can only text numbers verified under Console -> Phone Numbers -> Verified Caller
# IDs, and Sierra Leone must be enabled under Console -> Messaging -> Settings -> Geo Permissions.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
# Africa's Talking (SMS_PROVIDER=africastalking). Use AT_USERNAME="sandbox" for testing.
# Note: Africa's Talking does not cover Sierra Leone — use Twilio there.
AT_USERNAME=""
AT_API_KEY=""
AT_SENDER_ID=""
# Development allowlist: while set, SMS is only sent to these numbers (comma-separated) and
# everyone else is logged as skipped. Use it with a Twilio trial so seeded patients with unverified
# numbers don't burn trial credit on failed sends. Leave empty to text everyone.
SMS_ALLOWED_NUMBERS=""
# Protects /api/sms/inbound (text replies). Provider webhook URL: <APP_URL>/api/sms/inbound?token=<this value>
SMS_WEBHOOK_SECRET="replace-with-a-long-random-string"
# Protects /api/cron/sms (scheduled reminders)
CRON_SECRET="replace-with-a-long-random-string"
APP_URL="http://localhost:3000"

# Identity check on self-service sign-ups (Claude reads the photo and ID card). Get a key at console.anthropic.com
ANTHROPIC_API_KEY=""

# Video visits (daily.co). Dashboard > Developers > API key. Without it, video calls are disabled.
DAILY_API_KEY=""
