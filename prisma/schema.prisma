generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Serverless runtimes open a connection per invocation, so DATABASE_URL points at the
  // pooler. Migrations need a direct connection, which the pooler cannot serve.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum Role {
  ADMIN
  DOCTOR
  NURSE
  PHARMACIST
  RECEPTIONIST
  PATIENT
}

/// Outcome of the automatic identity check run on self-service sign-ups.
enum VerificationStatus {
  PENDING
  PASSED
  FLAGGED
  ERROR
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  REJECTED
  CANCELLED
}

enum VisitType {
  IN_PERSON
  VIDEO_CALL
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE_MONEY
  BANK_TRANSFER
  INSURANCE
}

enum StockMovementType {
  RECEIVED
  DISPENSED
  ADJUSTED
}

enum SmsDirection {
  OUTBOUND
  INBOUND
}

enum MessageSource {
  APP
  SMS
}

enum SmsStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum NotificationType {
  APPOINTMENT_REQUEST
  APPOINTMENT_ASSIGNED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_REJECTED
  APPOINTMENT_CANCELLED
  APPOINTMENT_COMPLETED
  APPOINTMENT_REMINDER
  PAYMENT_RECEIVED
  STOCK_LOW
  GENERAL
}

model Hospital {
  id        String   @id @default(cuid())
  name      String
  address   String?
  city      String?
  phone     String?
  email     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff        User[]
  appointments Appointment[]
  invoices     Invoice[]
}

model User {
  id                    String              @id @default(cuid())
  firstName             String
  lastName              String
  email                 String              @unique
  phone                 String?
  avatarUrl             String?
  dateOfBirth           DateTime?           @db.Date
  gender                Gender?
  address               String?
  city                  String?
  state                 String?
  country               String?
  zipCode               String?
  // Doctor details
  specialty             String?
  licenseNumber         String?
  experienceYears       Int?
  bio                   String?
  // Patient details
  bloodGroup            String?
  allergies             String?
  chronicConditions     String?
  emergencyContactName  String?
  emergencyContactPhone String?
  /// Consent to receive SMS notifications on `phone`.
  smsOptIn              Boolean             @default(true)
  isActive              Boolean             @default(true)
  // Identity verification for self-service sign-ups. The ID card is stored privately.
  idCardUrl             String?
  verificationStatus    VerificationStatus?
  /// The checker's findings, shown to admins (see src/lib/verification.ts).
  verificationReport    Json?
  verificationCheckedAt DateTime?
  password              String
  role                  Role
  hospitalId            String?
  hospital              Hospital?           @relation(fields: [hospitalId], references: [id])
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  doctorAppointments  Appointment[]             @relation("DoctorAppointments")
  patientAppointments Appointment[]             @relation("PatientAppointments")
  doctorRecords       MedicalRecord[]           @relation("DoctorRecords")
  patientRecords      MedicalRecord[]           @relation("PatientRecords")
  invoices            Invoice[]                 @relation("PatientInvoices")
  paymentsReceived    Payment[]
  dispensedMeds       Prescription[]            @relation("PrescriptionsDispensed")
  stockMovements      StockMovement[]           @relation("StockMovementsRecorded")
  notifications       Notification[]
  chatParticipations  ConversationParticipant[]
  messages            Message[]
  smsMessages         SmsMessage[]              @relation("SmsRecipient")
  smsSent             SmsMessage[]              @relation("SmsSender")

  @@index([role])
}

model Appointment {
  id                 String            @id @default(cuid())
  title              String
  notes              String?
  startsAt           DateTime
  endsAt             DateTime?
  status             AppointmentStatus @default(PENDING)
  visitType          VisitType         @default(IN_PERSON)
  // Video visits: the Daily room, and the secret in the patient's join link (/call/<key>).
  videoRoomName      String?
  videoRoomUrl       String?
  videoRoomExpiresAt DateTime?
  videoPatientKey    String?           @unique
  doctorId           String?
  doctor             User?             @relation("DoctorAppointments", fields: [doctorId], references: [id])
  patientId          String
  patient            User              @relation("PatientAppointments", fields: [patientId], references: [id])
  hospitalId         String?
  hospital           Hospital?         @relation(fields: [hospitalId], references: [id])
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  record   MedicalRecord?
  invoices Invoice[]

  @@index([startsAt])
  @@index([status])
}

/// A consultation: vitals, diagnosis, notes and prescriptions written by a doctor.
model MedicalRecord {
  id            String       @id @default(cuid())
  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  patientId     String
  patient       User         @relation("PatientRecords", fields: [patientId], references: [id])
  doctorId      String
  doctor        User         @relation("DoctorRecords", fields: [doctorId], references: [id])

  chiefComplaint   String?
  diagnosis        String
  notes            String?
  // Vitals
  temperature      Decimal?  @db.Decimal(4, 1) // °C
  bloodPressure    String? // e.g. "120/80"
  heartRate        Int? // bpm
  respiratoryRate  Int? // breaths/min
  oxygenSaturation Int? // %
  weight           Decimal?  @db.Decimal(5, 1) // kg
  height           Decimal?  @db.Decimal(5, 1) // cm
  followUpDate     DateTime? @db.Date

  prescriptions Prescription[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([patientId, createdAt])
}

model Prescription {
  id           String        @id @default(cuid())
  recordId     String
  record       MedicalRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  medication   String
  dosage       String
  frequency    String
  duration     String
  instructions String?

  // Set by a pharmacist when the medication is handed over.
  dispensedAt   DateTime?
  dispensedById String?
  dispensedBy   User?     @relation("PrescriptionsDispensed", fields: [dispensedById], references: [id])

  /// Which stock item was handed over. Null when the pharmacy doesn't stock it.
  medicationId      String?
  stockMedication   Medication? @relation(fields: [medicationId], references: [id], onDelete: SetNull)
  /// How many units came out of stock.
  dispensedQuantity Int?

  stockMovements StockMovement[]

  @@index([dispensedAt])
}

/// A medication the pharmacy stocks, with the quantity currently on hand.
model Medication {
  id           String   @id @default(cuid())
  name         String
  strength     String? // e.g. "500mg"
  form         String? // e.g. "Tablet", "Syrup"
  /// What one unit of stock is: tablet, capsule, bottle, vial.
  unit         String   @default("unit")
  /// Quantity on hand. Only ever changed alongside a StockMovement.
  quantity     Int      @default(0)
  /// Stock at or below this counts as low and raises an alert.
  reorderLevel Int      @default(0)
  unitPrice    Decimal? @db.Decimal(12, 2)
  notes        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  movements     StockMovement[]
  prescriptions Prescription[]

  @@unique([name, strength])
  @@index([isActive, name])
}

/// Append-only ledger of every change to a medication's stock, so the
/// quantity on hand can always be explained.
model StockMovement {
  id             String            @id @default(cuid())
  medicationId   String
  medication     Medication        @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  type           StockMovementType
  /// Signed: positive adds to stock, negative takes from it.
  change         Int
  /// Quantity on hand after this movement, so the history reads without re-summing.
  balance        Int
  note           String?
  /// Set when the movement was a pharmacist dispensing a prescription, or reversing one.
  prescriptionId String?
  prescription   Prescription?     @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  recordedById   String?
  recordedBy     User?             @relation("StockMovementsRecorded", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())

  @@index([medicationId, createdAt])
}

model Invoice {
  id            String        @id @default(cuid())
  number        Int           @unique @default(autoincrement())
  patientId     String
  patient       User          @relation("PatientInvoices", fields: [patientId], references: [id])
  appointmentId String?
  appointment   Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  hospitalId    String?
  hospital      Hospital?     @relation(fields: [hospitalId], references: [id])
  status        InvoiceStatus @default(UNPAID)
  total         Decimal       @db.Decimal(12, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(12, 2)
  dueDate       DateTime?     @db.Date
  notes         String?
  items         InvoiceItem[]
  payments      Payment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
  @@index([patientId])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
}

model Payment {
  id           String        @id @default(cuid())
  invoiceId    String
  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount       Decimal       @db.Decimal(12, 2)
  method       PaymentMethod
  reference    String?
  paidAt       DateTime      @default(now())
  receivedById String?
  receivedBy   User?         @relation(fields: [receivedById], references: [id], onDelete: SetNull)
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  link      String?
  /// Prevents duplicates for generated notifications such as reminders.
  dedupeKey String?          @unique
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

/// A chat thread: direct (exactly two people) or a named group.
model Conversation {
  id            String   @id @default(cuid())
  title         String? // group name; null for direct chats
  isGroup       Boolean  @default(false)
  /// "userA:userB" (sorted ids) for direct chats, so each pair has one thread.
  directKey     String?  @unique
  createdById   String?
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  participants ConversationParticipant[]
  messages     Message[]

  @@index([lastMessageAt])
}

model ConversationParticipant {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime     @default(now())
  joinedAt       DateTime     @default(now())

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  /// APP for messages typed in the chat, SMS for replies received by text message.
  source         MessageSource @default(APP)
  smsMessages    SmsMessage[]
  createdAt      DateTime      @default(now())

  @@index([conversationId, createdAt])
}

/// Every SMS the system tries to send, with its delivery outcome.
model SmsMessage {
  id                String       @id @default(cuid())
  userId            String?
  user              User?        @relation("SmsRecipient", fields: [userId], references: [id], onDelete: SetNull)
  /// Normalised E.164 number, or the raw value when it couldn't be normalised.
  to                String?
  body              String
  direction         SmsDirection @default(OUTBOUND)
  /// The chat message this SMS delivered (outbound) or created (inbound).
  messageId         String?
  message           Message?     @relation(fields: [messageId], references: [id], onDelete: SetNull)
  /// What triggered it, e.g. APPOINTMENT_CONFIRMED, APPOINTMENT_REMINDER, BROADCAST.
  category          String
  status            SmsStatus    @default(PENDING)
  provider          String?
  providerMessageId String?
  error             String?
  /// Prevents duplicates for scheduled messages such as reminders.
  dedupeKey         String?      @unique
  sentById          String?
  sentBy            User?        @relation("SmsSender", fields: [sentById], references: [id], onDelete: SetNull)
  createdAt         DateTime     @default(now())
  sentAt            DateTime?

  @@index([status])
  @@index([createdAt])
  @@index([userId])
  @@index([messageId])
}
