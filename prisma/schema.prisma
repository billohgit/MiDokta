generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Serverless runtimes open a connection per invocation, so DATABASE_URL points at the
  // pooler. Migrations need a direct connection, which the pooler cannot serve.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum Role {
  ADMIN
  DOCTOR
  NURSE
  PHARMACIST
  RECEPTIONIST
  PATIENT
}

/// Outcome of the automatic identity check run on self-service sign-ups.
enum VerificationStatus {
  PENDING
  PASSED
  FLAGGED
  ERROR
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  REJECTED
  CANCELLED
}

enum VisitType {
  IN_PERSON
  VIDEO_CALL
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE_MONEY
  BANK_TRANSFER
  INSURANCE
  /// Paid by the patient through the online checkout (mobile money or card).
  ONLINE
}

/// How the patient chose to pay at the online checkout. TENKIPAY checkouts run on TenkiPay; the rest on Monime.
enum CheckoutChannel {
  MOBILE_MONEY
  CARD
  BANK
  TENKIPAY
}

/// A mobile money or wallet account money can be sent to.
enum MobileWallet {
  ORANGE_MONEY
  AFRIMONEY
  QMONEY
  TENKIPAY
}

enum PayoutKind {
  /// The doctor's share of a consultation fee, sent once the visit is completed.
  DOCTOR_SHARE
  /// The whole amount back to the patient: a consultation declined or cancelled, or a pharmacy order cancelled.
  REFUND
  /// A pharmacy's share of an order, sent once the patient has it.
  PHARMACY_SHARE
}

enum PharmacyOrderStatus {
  /// Placed, waiting for the patient to pay.
  AWAITING_PAYMENT
  /// Paid; the pharmacy is preparing it.
  PAID
  /// Out for delivery, or ready for pickup.
  DISPATCHED
  /// The pharmacy says it was handed over; the patient confirms, or it's confirmed automatically.
  DELIVERED
  /// The patient has it: the pharmacy has been paid.
  RECEIVED
  /// The patient says it never arrived: an admin decides.
  DISPUTED
  CANCELLED
}

enum Fulfilment {
  DELIVERY
  PICKUP
}

enum PayoutStatus {
  /// Not yet accepted by the provider (or the attempt to send it didn't get an answer).
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum CheckoutStatus {
  PENDING
  COMPLETED
  CANCELLED
  EXPIRED
}

enum CallStatus {
  RINGING
  ACCEPTED
  DECLINED
  MISSED
  CANCELLED
  ENDED
}

enum StockMovementType {
  RECEIVED
  DISPENSED
  ADJUSTED
}

enum SmsDirection {
  OUTBOUND
  INBOUND
}

enum MessageSource {
  APP
  SMS
}

enum SmsStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum NotificationType {
  APPOINTMENT_REQUEST
  APPOINTMENT_ASSIGNED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_REJECTED
  APPOINTMENT_CANCELLED
  APPOINTMENT_COMPLETED
  APPOINTMENT_REMINDER
  PAYMENT_RECEIVED
  VIDEO_CALL
  STOCK_LOW
  GENERAL
}

model Hospital {
  id        String   @id @default(cuid())
  name      String
  address   String?
  city      String?
  phone     String?
  email     String?
  /// Map position, so patients can be directed to the nearest hospital (src/lib/omega/hospitals.ts).
  latitude  Float?
  longitude Float?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff        User[]
  appointments Appointment[]
  invoices     Invoice[]
}

model User {
  id                    String              @id @default(cuid())
  firstName             String
  lastName              String
  email                 String              @unique
  phone                 String?
  avatarUrl             String?
  dateOfBirth           DateTime?           @db.Date
  gender                Gender?
  address               String?
  city                  String?
  state                 String?
  country               String?
  zipCode               String?
  // Doctor details
  specialty             String?
  licenseNumber         String?
  experienceYears       Int?
  bio                   String?
  /// What a patient pays to book this doctor; null or 0 means booking is free.
  consultationFee       Decimal?            @db.Decimal(12, 2)
  /// Where the doctor's share of consultation fees is sent.
  payoutWallet          MobileWallet?
  payoutAccount         String?
  // Patient details
  bloodGroup            String?
  allergies             String?
  chronicConditions     String?
  /// The patient's own answer to "what is your main illness or health concern?", given when
  /// registering (optional). Drives the doctor and medicine suggestions on their dashboard.
  mainIllness           String?
  emergencyContactName  String?
  emergencyContactPhone String?
  /// Consent to receive SMS notifications on `phone`.
  smsOptIn              Boolean             @default(true)
  isActive              Boolean             @default(true)
  // Identity verification for self-service sign-ups. The ID card is stored privately.
  idCardUrl             String?
  verificationStatus    VerificationStatus?
  /// The checker's findings, shown to admins (see src/lib/verification.ts).
  verificationReport    Json?
  verificationCheckedAt DateTime?
  password              String
  /// Sessions signed in before this are no longer valid (set when the password is reset).
  passwordChangedAt     DateTime?
  role                  Role
  hospitalId            String?
  hospital              Hospital?           @relation(fields: [hospitalId], references: [id])
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  doctorAppointments  Appointment[]             @relation("DoctorAppointments")
  patientAppointments Appointment[]             @relation("PatientAppointments")
  doctorRecords       MedicalRecord[]           @relation("DoctorRecords")
  patientRecords      MedicalRecord[]           @relation("PatientRecords")
  invoices            Invoice[]                 @relation("PatientInvoices")
  paymentsReceived    Payment[]
  dispensedMeds       Prescription[]            @relation("PrescriptionsDispensed")
  stockMovements      StockMovement[]           @relation("StockMovementsRecorded")
  notifications       Notification[]
  chatParticipations  ConversationParticipant[]
  messages            Message[]
  smsMessages         SmsMessage[]              @relation("SmsRecipient")
  smsSent             SmsMessage[]              @relation("SmsSender")
  callsMade           Call[]                    @relation("CallsMade")
  callsReceived       Call[]                    @relation("CallsReceived")
  ratingsReceived     DoctorRating[]            @relation("RatingsReceived")
  ratingsGiven        DoctorRating[]            @relation("RatingsGiven")
  consultationsBooked Consultation[]            @relation("PatientConsultations")
  consultationsGiven  Consultation[]            @relation("DoctorConsultations")
  payoutsReceived     Payout[]
  pharmacy            Pharmacy?
  cartItems           CartItem[]
  pharmacyOrders      PharmacyOrder[]
  testsAsPatient      DiagnosticTest[]          @relation("PatientTests")
  testsOrdered        DiagnosticTest[]          @relation("TestsOrdered")
  testResultsEntered  DiagnosticTest[]          @relation("TestResultsEntered")
  referralsAsPatient  Referral[]                @relation("PatientReferrals")
  referralsMade       Referral[]                @relation("ReferralsMade")
  referralsReceived   Referral[]                @relation("ReferralsReceived")
  referralsNavigated  Referral[]                @relation("ReferralsNavigated")
  referralsClosed     Referral[]                @relation("ReferralsClosed")
  careEvents          CareEvent[]               @relation("CareEventsLogged")
  prescriptionScans   PrescriptionScan[]
  passwordResets      PasswordResetCode[]
  invitesSent         PatientInvite[]           @relation("InvitesSent")
  invitesAccepted     PatientInvite[]           @relation("InvitesAccepted")

  @@index([role])
}

model Appointment {
  id         String            @id @default(cuid())
  title      String
  notes      String?
  startsAt   DateTime
  endsAt     DateTime?
  status     AppointmentStatus @default(PENDING)
  visitType  VisitType         @default(IN_PERSON)
  doctorId   String?
  doctor     User?             @relation("DoctorAppointments", fields: [doctorId], references: [id])
  patientId  String
  patient    User              @relation("PatientAppointments", fields: [patientId], references: [id])
  hospitalId String?
  hospital   Hospital?         @relation(fields: [hospitalId], references: [id])
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  record   MedicalRecord?
  invoices Invoice[]
  calls    Call[]
  rating   DoctorRating?
  /// The paid booking this appointment came from, if the doctor charges a fee.
  consultation Consultation?
  /// The referral this appointment was booked for, if any.
  referral     Referral?

  @@index([startsAt])
  @@index([status])
}

/// A consultation: vitals, diagnosis, notes and prescriptions written by a doctor.
/// A patient's 1–5 star rating of a completed visit: the consultation and how the doctor dealt
/// with them. One per appointment; the patient can change it. Doctors see ratings without names.
model DoctorRating {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  doctorId      String
  doctor        User        @relation("RatingsReceived", fields: [doctorId], references: [id], onDelete: Cascade)
  patientId     String
  patient       User        @relation("RatingsGiven", fields: [patientId], references: [id], onDelete: Cascade)
  stars         Int
  comment       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([doctorId, createdAt])
}

model MedicalRecord {
  id            String       @id @default(cuid())
  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  patientId     String
  patient       User         @relation("PatientRecords", fields: [patientId], references: [id])
  doctorId      String
  doctor        User         @relation("DoctorRecords", fields: [doctorId], references: [id])

  chiefComplaint   String?
  diagnosis        String
  notes            String?
  // Vitals
  temperature      Decimal?  @db.Decimal(4, 1) // °C
  bloodPressure    String? // e.g. "120/80"
  heartRate        Int? // bpm
  respiratoryRate  Int? // breaths/min
  oxygenSaturation Int? // %
  weight           Decimal?  @db.Decimal(5, 1) // kg
  height           Decimal?  @db.Decimal(5, 1) // cm
  followUpDate     DateTime? @db.Date

  prescriptions Prescription[]
  tests         DiagnosticTest[]
  referrals     Referral[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([patientId, createdAt])
}

model Prescription {
  id           String        @id @default(cuid())
  recordId     String
  record       MedicalRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  medication   String
  dosage       String
  frequency    String
  duration     String
  instructions String?

  // Set by a pharmacist when the medication is handed over.
  dispensedAt   DateTime?
  dispensedById String?
  dispensedBy   User?     @relation("PrescriptionsDispensed", fields: [dispensedById], references: [id])

  /// Which stock item was handed over. Null when the pharmacy doesn't stock it.
  medicationId      String?
  stockMedication   Medication? @relation(fields: [medicationId], references: [id], onDelete: SetNull)
  /// How many units came out of stock.
  dispensedQuantity Int?

  stockMovements StockMovement[]

  @@index([dispensedAt])
}

/// A medication the pharmacy stocks, with the quantity currently on hand.
model Medication {
  id           String   @id @default(cuid())
  name         String
  strength     String? // e.g. "500mg"
  form         String? // e.g. "Tablet", "Syrup"
  /// What one unit of stock is: tablet, capsule, bottle, vial.
  unit         String   @default("unit")
  /// Quantity on hand. Only ever changed alongside a StockMovement.
  quantity     Int      @default(0)
  /// Stock at or below this counts as low and raises an alert.
  reorderLevel Int      @default(0)
  unitPrice    Decimal? @db.Decimal(12, 2)
  notes        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  movements     StockMovement[]
  prescriptions Prescription[]

  @@unique([name, strength])
  @@index([isActive, name])
}

/// Append-only ledger of every change to a medication's stock, so the
/// quantity on hand can always be explained.
model StockMovement {
  id             String            @id @default(cuid())
  medicationId   String
  medication     Medication        @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  type           StockMovementType
  /// Signed: positive adds to stock, negative takes from it.
  change         Int
  /// Quantity on hand after this movement, so the history reads without re-summing.
  balance        Int
  note           String?
  /// Set when the movement was a pharmacist dispensing a prescription, or reversing one.
  prescriptionId String?
  prescription   Prescription?     @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  recordedById   String?
  recordedBy     User?             @relation("StockMovementsRecorded", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())

  @@index([medicationId, createdAt])
}

model Invoice {
  id            String            @id @default(cuid())
  number        Int               @unique @default(autoincrement())
  patientId     String
  patient       User              @relation("PatientInvoices", fields: [patientId], references: [id])
  appointmentId String?
  appointment   Appointment?      @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  hospitalId    String?
  hospital      Hospital?         @relation(fields: [hospitalId], references: [id])
  status        InvoiceStatus     @default(UNPAID)
  total         Decimal           @db.Decimal(12, 2)
  amountPaid    Decimal           @default(0) @db.Decimal(12, 2)
  dueDate       DateTime?         @db.Date
  notes         String?
  /// The secret in the patient's payment link (/pay/<key>).
  payKey        String?           @unique
  items         InvoiceItem[]
  payments      Payment[]
  checkouts     CheckoutSession[]
  /// Set when this invoice is a consultation fee paid at booking.
  consultation  Consultation?
  /// Set when this invoice is a pharmacy order.
  pharmacyOrder PharmacyOrder?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status])
  @@index([patientId])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
}

model Payment {
  id           String           @id @default(cuid())
  invoiceId    String
  invoice      Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount       Decimal          @db.Decimal(12, 2)
  method       PaymentMethod
  reference    String?
  paidAt       DateTime         @default(now())
  receivedById String?
  receivedBy   User?            @relation(fields: [receivedById], references: [id], onDelete: SetNull)
  checkout     CheckoutSession?
}

/// An online payment attempt through Monime's hosted checkout (src/lib/payments.ts).
model CheckoutSession {
  id          String           @id @default(cuid())
  invoiceId   String
  invoice     Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  /// The provider's checkout session id (Monime's, or TenkiPay's for TENKIPAY checkouts).
  sessionId   String           @unique
  redirectUrl String
  amount      Decimal          @db.Decimal(12, 2)
  status      CheckoutStatus   @default(PENDING)
  /// The only method the checkout offered; null for checkouts that offered every method.
  channel     CheckoutChannel?
  /// The payment recorded when the checkout completed.
  paymentId   String?          @unique
  payment     Payment?         @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([invoiceId])
  @@index([status, createdAt])
}

/**
 * A patient's booking with a doctor who charges a fee. The fee is paid online before the doctor
 * hears about it: the appointment is only created once the invoice is paid. Of the fee, the
 * platform keeps platformFee and the doctor is paid doctorShare when the visit is completed; if it's
 * declined or cancelled first, the whole fee is refunded to the patient's refund account.
 */
model Consultation {
  id            String        @id @default(cuid())
  patientId     String
  patient       User          @relation("PatientConsultations", fields: [patientId], references: [id])
  doctorId      String
  doctor        User          @relation("DoctorConsultations", fields: [doctorId], references: [id])
  invoiceId     String        @unique
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  appointmentId String?       @unique
  appointment   Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  // The visit asked for; copied onto the appointment once paid.
  title         String
  startsAt      DateTime
  visitType     VisitType
  hospitalId    String?
  fee           Decimal       @db.Decimal(12, 2)
  platformFee   Decimal       @db.Decimal(12, 2)
  doctorShare   Decimal       @db.Decimal(12, 2)
  refundWallet  MobileWallet
  refundAccount String
  /// How the fee was paid; payouts and refunds come from the same provider.
  paidVia       CheckoutChannel?
  paidAt        DateTime?
  payouts       Payout[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([doctorId])
}

/** Money sent out of the platform's Monime or TenkiPay account for a consultation or a pharmacy order. */
model Payout {
  id             String         @id @default(cuid())
  consultationId String?
  consultation   Consultation?  @relation(fields: [consultationId], references: [id])
  orderId        String?
  order          PharmacyOrder? @relation(fields: [orderId], references: [id])
  kind           PayoutKind
  recipientId    String
  recipient      User         @relation(fields: [recipientId], references: [id])
  amount         Decimal      @db.Decimal(12, 2)
  /// Sent through TenkiPay (for fees paid with TenkiPay) rather than Monime.
  viaTenkipay    Boolean
  /// Where it goes; null while a doctor's payment waits for them to add a payout number.
  wallet         MobileWallet?
  account        String?
  status         PayoutStatus @default(PENDING)
  /// The provider's payout (Monime) or transfer (TenkiPay) id.
  providerId     String?      @unique
  failureReason  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  /// At most one payment and one refund per consultation, and per order.
  @@unique([consultationId, kind])
  @@unique([orderId, kind])
  @@index([status])
}

/** An independent pharmacy, run by a pharmacist, selling its own stock to patients. */
model Pharmacy {
  id            String            @id @default(cuid())
  ownerId       String            @unique
  owner         User              @relation(fields: [ownerId], references: [id])
  name          String
  address       String
  city          String?
  phone         String?
  /// Map position, so patients see how far away it is. Set by the pharmacist standing in the pharmacy.
  latitude      Float?
  longitude     Float?
  /// What home delivery costs; null means pickup only.
  deliveryFee   Decimal?          @db.Decimal(12, 2)
  /// Where the pharmacy's share of orders is sent.
  payoutWallet  MobileWallet?
  payoutAccount String?
  /// Admins can take a pharmacy off the shop.
  isActive      Boolean           @default(true)
  products      PharmacyProduct[]
  orders        PharmacyOrder[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

/** Something a pharmacy sells, with its own price and stock (separate from the clinic's inventory). */
model PharmacyProduct {
  id          String              @id @default(cuid())
  pharmacyId  String
  pharmacy    Pharmacy            @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  name        String
  strength    String?
  form        String?
  description String?
  /// A photo of the product, uploaded by the pharmacy (public, like avatars).
  imageUrl    String?
  price       Decimal             @db.Decimal(12, 2)
  /// Units in stock. Taken when an order is paid, put back when a paid order is cancelled.
  quantity    Int                 @default(0)
  isActive    Boolean             @default(true)
  cartItems   CartItem[]
  orderItems  PharmacyOrderItem[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([pharmacyId])
  @@index([isActive, name])
}

/**
 * A photo of a (usually handwritten) prescription and the AI's reading of it. Taken by a patient in
 * the shop or a pharmacist at the counter. The reading is a suggestion that a person checks against
 * the photo; the photo travels with any order made from it so the pharmacy can check it too.
 */
model PrescriptionScan {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The photo, in the private store ("blob:<pathname>") or on local disk in development ("local:<path>").
  imageRef  String
  /// The AI's reading: medicines with strength, dose, frequency, duration and confidence, plus warnings.
  result    Json
  cartItems CartItem[]
  orders    PharmacyOrder[]
  createdAt DateTime        @default(now())

  @@index([userId, createdAt])
}

/** A patient's shopping cart: one row per product, all from one pharmacy. */
model CartItem {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   PharmacyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  /// The prescription scan this was added from, if any; it goes with the order.
  prescriptionScanId String?
  prescriptionScan   PrescriptionScan? @relation(fields: [prescriptionScanId], references: [id], onDelete: SetNull)
  createdAt DateTime        @default(now())

  @@unique([userId, productId])
}

/**
 * A patient's order from one pharmacy, paid online through its invoice. Of the medicines, the
 * platform keeps platformFee; the pharmacy is paid pharmacyShare (the rest, plus the delivery fee)
 * once the patient has the order. A paid order cancelled before then is refunded in full.
 */
model PharmacyOrder {
  id              String              @id @default(cuid())
  number          Int                 @unique @default(autoincrement())
  patientId       String
  patient         User                @relation(fields: [patientId], references: [id])
  pharmacyId      String
  pharmacy        Pharmacy            @relation(fields: [pharmacyId], references: [id])
  invoiceId       String              @unique
  invoice         Invoice             @relation(fields: [invoiceId], references: [id])
  status          PharmacyOrderStatus @default(AWAITING_PAYMENT)
  fulfilment      Fulfilment
  deliveryAddress String?
  contactPhone    String
  subtotal        Decimal             @db.Decimal(12, 2)
  deliveryFee     Decimal             @db.Decimal(12, 2)
  total           Decimal             @db.Decimal(12, 2)
  platformFee     Decimal             @db.Decimal(12, 2)
  pharmacyShare   Decimal             @db.Decimal(12, 2)
  refundWallet    MobileWallet
  refundAccount   String
  paidVia         CheckoutChannel?
  paidAt          DateTime?
  dispatchedAt    DateTime?
  deliveredAt     DateTime?
  receivedAt      DateTime?
  cancelledAt     DateTime?
  /// Why it was cancelled, or what the patient reported when disputing it.
  note            String?
  /// The prescription photo the order was made from, for the pharmacy to check.
  prescriptionScanId String?
  prescriptionScan   PrescriptionScan? @relation(fields: [prescriptionScanId], references: [id], onDelete: SetNull)
  items           PharmacyOrderItem[]
  payouts         Payout[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([pharmacyId, status])
  @@index([patientId])
  @@index([status, deliveredAt])
}

/** A line of an order, copied from the product when ordered so later edits don't change it. */
model PharmacyOrderItem {
  id        String           @id @default(cuid())
  orderId   String
  order     PharmacyOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   PharmacyProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  unitPrice Decimal          @db.Decimal(12, 2)
  quantity  Int
}

enum TestKind {
  LAB
  IMAGING
  OTHER
}

enum TestStatus {
  /// Ordered by the doctor; waiting for the sample (or the scan).
  ORDERED
  /// Sample taken or scan done; waiting for the result.
  COLLECTED
  /// Result in; waiting for the ordering doctor to review it.
  RESULTED
  /// Reviewed; waiting for the patient to be told.
  REVIEWED
  /// The patient has been told: nothing left to follow up.
  COMMUNICATED
  CANCELLED
}

enum Urgency {
  ROUTINE
  URGENT
  EMERGENCY
}

enum ReferralStatus {
  /// Referred; the navigator is arranging the appointment.
  CREATED
  /// An appointment with the specialist or facility is booked.
  SCHEDULED
  /// The patient went.
  ATTENDED
  /// The specialist's findings are back; waiting for the referring doctor to close the loop.
  REPORT_RECEIVED
  /// The referring doctor documented the outcome: the loop is closed.
  CLOSED
  CANCELLED
}

/** A diagnostic test or lab investigation a doctor ordered, followed until the patient knows the result. */
model DiagnosticTest {
  id           String      @id @default(cuid())
  patientId    String
  patient      User        @relation("PatientTests", fields: [patientId], references: [id])
  orderedById  String
  orderedBy    User        @relation("TestsOrdered", fields: [orderedById], references: [id])
  /// The consultation it was ordered from, if any.
  recordId     String?
  record       MedicalRecord? @relation(fields: [recordId], references: [id], onDelete: SetNull)
  name         String
  kind         TestKind
  urgency      Urgency     @default(ROUTINE)
  /// What the doctor wants to know, for the lab and the reviewer.
  question     String?
  status       TestStatus  @default(ORDERED)
  /// When the result should be in; past this with no result, the test is overdue.
  dueAt        DateTime
  collectedAt  DateTime?
  result       String?
  abnormal     Boolean?
  resultedAt   DateTime?
  resultById   String?
  resultBy     User?       @relation("TestResultsEntered", fields: [resultById], references: [id], onDelete: SetNull)
  reviewNote   String?
  reviewedAt   DateTime?
  communicatedAt DateTime?
  cancelledAt  DateTime?
  events       CareEvent[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status, dueAt])
  @@index([patientId])
  @@index([orderedById, status])
}

/**
 * A referral to a specialist (a MiDokta doctor or an outside facility), followed by a care
 * navigator until the referring doctor documents the outcome and closes the loop.
 */
model Referral {
  id                  String         @id @default(cuid())
  number              Int            @unique @default(autoincrement())
  patientId           String
  patient             User           @relation("PatientReferrals", fields: [patientId], references: [id])
  referredById        String
  referredBy          User           @relation("ReferralsMade", fields: [referredById], references: [id])
  recordId            String?
  record              MedicalRecord? @relation(fields: [recordId], references: [id], onDelete: SetNull)
  /// A MiDokta doctor the patient is referred to, or else `toFacility` outside MiDokta.
  toDoctorId          String?
  toDoctor            User?          @relation("ReferralsReceived", fields: [toDoctorId], references: [id], onDelete: SetNull)
  toFacility          String?
  specialty           String
  reason              String
  urgency             Urgency        @default(ROUTINE)
  status              ReferralStatus @default(CREATED)
  /// The staff member helping the patient through the referral.
  navigatorId         String?
  navigator           User?          @relation("ReferralsNavigated", fields: [navigatorId], references: [id], onDelete: SetNull)
  /// What the patient needs to know: where to go, what to bring. Shown to them and texted on request.
  patientInstructions String?
  /// The navigator's next action, and when it's due.
  nextStep            String?
  nextStepDue         DateTime?
  appointmentAt       DateTime?
  /// For a referral to a MiDokta doctor, the appointment booked with them.
  appointmentId       String?        @unique
  appointment         Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  scheduledAt         DateTime?
  attendedAt          DateTime?
  reportSummary       String?
  reportReceivedAt    DateTime?
  /// The referring doctor's documented outcome, required to close the loop.
  closureNote         String?
  closedAt            DateTime?
  closedById          String?
  closedBy            User?          @relation("ReferralsClosed", fields: [closedById], references: [id], onDelete: SetNull)
  cancelledAt         DateTime?
  events              CareEvent[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([status])
  @@index([patientId])
  @@index([referredById, status])
  @@index([navigatorId, status])
}

/** One entry on a test's or referral's timeline: a status change, a note, a contact with the patient, or an alert. */
model CareEvent {
  id         String          @id @default(cuid())
  testId     String?
  test       DiagnosticTest? @relation(fields: [testId], references: [id], onDelete: Cascade)
  referralId String?
  referral   Referral?       @relation(fields: [referralId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?           @relation("CareEventsLogged", fields: [actorId], references: [id], onDelete: SetNull)
  /// STATUS, NOTE, CONTACT (a call or visit with the patient), SMS or ALERT.
  kind       String
  text       String
  createdAt  DateTime        @default(now())

  @@index([testId, createdAt])
  @@index([referralId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  link      String?
  /// Prevents duplicates for generated notifications such as reminders.
  dedupeKey String?          @unique
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

/// A chat thread: direct (exactly two people) or a named group.
model Conversation {
  id            String   @id @default(cuid())
  title         String? // group name; null for direct chats
  isGroup       Boolean  @default(false)
  /// "userA:userB" (sorted ids) for direct chats, so each pair has one thread.
  directKey     String?  @unique
  createdById   String?
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  participants ConversationParticipant[]
  messages     Message[]

  @@index([lastMessageAt])
}

model ConversationParticipant {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime     @default(now())
  joinedAt       DateTime     @default(now())

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  /// The text; may be empty when the message is just an attachment.
  body           String
  /// A photo or video sent with the message: "blob:<pathname>" in the private Blob store, or
  /// "local:<path>" under uploads/ in development. Only ever served to the conversation's members.
  attachmentRef  String?
  attachmentType String?
  attachmentName String?
  attachmentSize Int?
  /// APP for messages typed in the chat, SMS for replies received by text message.
  source         MessageSource @default(APP)
  smsMessages    SmsMessage[]
  createdAt      DateTime      @default(now())

  @@index([conversationId, createdAt])
}

/// Every SMS the system tries to send, with its delivery outcome.
model SmsMessage {
  id                String       @id @default(cuid())
  userId            String?
  user              User?        @relation("SmsRecipient", fields: [userId], references: [id], onDelete: SetNull)
  /// Normalised E.164 number, or the raw value when it couldn't be normalised.
  to                String?
  body              String
  direction         SmsDirection @default(OUTBOUND)
  /// The chat message this SMS delivered (outbound) or created (inbound).
  messageId         String?
  message           Message?     @relation(fields: [messageId], references: [id], onDelete: SetNull)
  /// What triggered it, e.g. APPOINTMENT_CONFIRMED, APPOINTMENT_REMINDER, BROADCAST.
  category          String
  status            SmsStatus    @default(PENDING)
  provider          String?
  providerMessageId String?
  error             String?
  /// Prevents duplicates for scheduled messages such as reminders.
  dedupeKey         String?      @unique
  sentById          String?
  sentBy            User?        @relation("SmsSender", fields: [sentById], references: [id], onDelete: SetNull)
  createdAt         DateTime     @default(now())
  sentAt            DateTime?

  @@index([status])
  @@index([createdAt])
  @@index([userId])
  @@index([messageId])
}

/// A video call placed in the app: one person rings another, who answers or declines (src/lib/calls.ts).
model Call {
  id            String       @id @default(cuid())
  callerId      String
  caller        User         @relation("CallsMade", fields: [callerId], references: [id], onDelete: Cascade)
  calleeId      String
  callee        User         @relation("CallsReceived", fields: [calleeId], references: [id], onDelete: Cascade)
  /// The visit this call belongs to, so the doctor can write it up.
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  status        CallStatus   @default(RINGING)
  /// The private Daily room both sides join once the call is answered.
  roomName      String
  roomUrl       String
  roomExpiresAt DateTime
  /// Updated while each side has the call open, so abandoned calls can be ended.
  callerSeenAt  DateTime     @default(now())
  calleeSeenAt  DateTime?
  answeredAt    DateTime?
  endedAt       DateTime?
  createdAt     DateTime     @default(now())

  @@index([calleeId, status])
  @@index([callerId, status])
}

/// A one-time code texted to a patient's phone to sign in (src/lib/login-codes.ts).
/** A one-time code texted to an account's phone to reset a forgotten password. Stored hashed. */
model PasswordResetCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

enum InviteStatus {
  /// Texted; waiting for the patient to register.
  PENDING
  /// The patient registered and the visit was booked.
  ACCEPTED
  CANCELLED
}

/**
 * A doctor booking a visit for someone who isn't on MiDokta yet. They're texted a link to register;
 * registering books the visit with that doctor (paying the fee first if there is one).
 */
model PatientInvite {
  id            String       @id @default(cuid())
  /// The secret in the registration link (/invite/<token>).
  token         String       @unique
  doctorId      String
  doctor        User         @relation("InvitesSent", fields: [doctorId], references: [id], onDelete: Cascade)
  firstName     String
  lastName      String
  /// E.164; the link is texted here, and the account is registered with it.
  phone         String
  title         String
  startsAt      DateTime
  visitType     VisitType
  /// The doctor's fee when they sent it, which is what the patient was told.
  fee           Decimal?     @db.Decimal(12, 2)
  status        InviteStatus @default(PENDING)
  expiresAt     DateTime
  patientId     String?
  patient       User?        @relation("InvitesAccepted", fields: [patientId], references: [id], onDelete: SetNull)
  /// The fee invoice (when there's a fee) or the appointment (when there isn't), once registered.
  invoiceId     String?      @unique
  appointmentId String?      @unique
  acceptedAt    DateTime?
  createdAt     DateTime     @default(now())

  @@index([doctorId, createdAt])
  @@index([phone])
}

model LoginCode {
  id         String    @id @default(cuid())
  /// Normalised E.164 number the code was sent to.
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  /// Set when the code was right but the number belongs to several patients, who must pick one.
  verifiedAt DateTime?
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}
